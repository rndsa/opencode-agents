#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# OpenCode Agents Manager (Termux Edition) - Auto Agent MD Switcher & Hub
# ==============================================================================

set -e

# Setup TTY
if [ -t 0 ]; then
    HAS_TTY=true
elif [ -e /dev/tty ]; then
    exec < /dev/tty
    HAS_TTY=true
else
    HAS_TTY=false
fi

# ANSI Palette (Clean Zinc / OpenCode Style)
ESC="\033"
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_DIM="${ESC}[38;5;242m"
C_CYAN="${ESC}[38;5;81m"
C_GREEN="${ESC}[38;5;120m"
C_WHITE="${ESC}[38;5;255m"
C_GRAY="${ESC}[38;5;246m"
C_YELLOW="${ESC}[38;5;221m"
C_RED="${ESC}[38;5;203m"

hide_cursor() { printf "${ESC}[?25l"; }
show_cursor() { printf "${ESC}[?25h"; }

wipe_screen() {
    clear 2>/dev/null || true
    printf "${ESC}[H${ESC}[2J${ESC}[3J"
}

cleanup() {
    show_cursor
    printf "${C_RESET}\n"
}
trap cleanup EXIT INT TERM

AGENTS_DIR="$HOME/.config/opencode/agents"
ACTIVE_AGENT_FILE="$AGENTS_DIR/agent.md"
MT_STORAGE_FILE="/sdcard/agent.md"
mkdir -p "$AGENTS_DIR"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo "")"
LOCAL_TEMPLATES="$SCRIPT_DIR/../agents"

# 7 Official Built-in Agents
KEYS=(
    "builder"
    "reviewer"
    "architect"
    "security-audit"
    "ui-designer"
    "debugger"
    "documenter"
)

NAMES=(
    "builder        "
    "reviewer       "
    "architect      "
    "security-audit "
    "ui-designer    "
    "debugger       "
    "documenter     "
)

ROLES=(
    "Full-Stack Dev   [Primary] "
    "Code Review QA   [Subagent]"
    "Clean Architect  [Primary] "
    "Security Audit   [Primary] "
    "Modern UI/UX     [Primary] "
    "Diagnostics/Fix  [Primary] "
    "Docs & API Specs [Subagent]"
)

TOTAL=${#KEYS[@]}
CURRENT=0

# Detect active agent
detect_active() {
    if [ ! -f "$ACTIVE_AGENT_FILE" ]; then
        echo 0
        return
    fi
    for i in $(seq 0 $((TOTAL - 1))); do
        key="${KEYS[$i]}"
        if cmp -s "$ACTIVE_AGENT_FILE" "$AGENTS_DIR/$key.md" 2>/dev/null; then
            echo "$i"
            return
        fi
    done
    echo 0
}

ACTIVE_INDEX=$(detect_active)
CURRENT=$ACTIVE_INDEX

render_menu() {
    wipe_screen
    echo ""
    echo -e "  ${C_CYAN}${C_BOLD}OpenCode${C_RESET} ${C_DIM}v2.0.19 · Agents Hub${C_RESET}"
    echo ""
    echo -e "  ${C_WHITE}Pilih template agent untuk diaktifkan:${C_RESET}"
    echo ""

    for i in $(seq 0 $((TOTAL - 1))); do
        if [ "$i" -eq "$ACTIVE_INDEX" ]; then
            BULLET="${C_GREEN}●${C_RESET}"
        else
            BULLET="${C_DIM}○${C_RESET}"
        fi

        NUM="$((i + 1))"
        NAME="${NAMES[$i]}"
        ROLE="${ROLES[$i]}"

        if [ "$i" -eq "$CURRENT" ]; then
            CURSOR="${C_CYAN}›${C_RESET}"
            LINE="${C_WHITE}${C_BOLD}$NUM. $NAME${C_RESET} ${C_GRAY}$ROLE${C_RESET}"
        else
            CURSOR=" "
            LINE="${C_DIM}$NUM. $NAME $ROLE${C_RESET}"
        fi

        echo -e "  $CURSOR $BULLET  $LINE"
    done

    echo ""
    echo -e "  ${C_DIM}─────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_DIM}Navigasi:${C_RESET} ${C_WHITE}[↑/↓]${C_RESET} Geser · ${C_WHITE}[1-7]${C_RESET} Langsung · ${C_GREEN}[Enter]${C_RESET} Terapkan"
    echo -e "  ${C_DIM}Storage: ${C_RESET} ${C_CYAN}[s]${C_RESET} Sambungkan ke MT Manager (/sdcard/agent.md)"
    echo -e "  ${C_DIM}Keluar:  ${C_RESET} ${C_DIM}[q] Batal${C_RESET}"
}

sync_templates() {
    # Ensure all template files exist in ~/.config/opencode/agents/
    for key in "${KEYS[@]}"; do
        target="$AGENTS_DIR/$key.md"
        if [ ! -f "$target" ]; then
            if [ -d "$LOCAL_TEMPLATES" ] && [ -f "$LOCAL_TEMPLATES/$key.md" ]; then
                cp "$LOCAL_TEMPLATES/$key.md" "$target"
            else
                curl -fsSL "https://raw.githubusercontent.com/rndsa/opencode-agents/main/agents/$key.md" -o "$target" 2>/dev/null || true
            fi
        fi
    done
}

link_storage() {
    wipe_screen
    echo ""
    echo -e "  ${C_CYAN}${C_BOLD}OpenCode${C_RESET} ${C_DIM}· MT Manager Storage Link${C_RESET}"
    echo ""
    if [ -d "/sdcard" ]; then
        ln -sf "$ACTIVE_AGENT_FILE" "$MT_STORAGE_FILE" 2>/dev/null || cp "$ACTIVE_AGENT_FILE" "$MT_STORAGE_FILE" 2>/dev/null || true
        echo -e "  ${C_GREEN}✓ Berhasil disambungkan ke Internal Storage!${C_RESET}"
        echo -e "  ${C_WHITE}Lokasi file di MT Manager:${C_RESET} ${C_CYAN}/sdcard/agent.md${C_RESET}"
        echo -e "  ${C_DIM}Setiap perubahan di MT Manager langsung aktif di OpenCode.${C_RESET}"
    else
        echo -e "  ${C_RED}[!] Error: /sdcard tidak ditemukan. Pastikan izin storage aktif.${C_RESET}"
        echo -e "  ${C_DIM}Ketik 'termux-setup-storage' di Termux lalu coba lagi.${C_RESET}"
    fi
    echo ""
    echo -e "  ${C_DIM}Tekan sembarang tombol untuk kembali...${C_RESET}"
    read -rsn1 _
}

sync_templates

if [ "$HAS_TTY" = true ]; then
    hide_cursor
    while true; do
        render_menu
        IFS= read -rsn1 key

        if [[ "$key" == "$ESC" ]]; then
            read -rsn2 -t 0.1 rest || true
            case "$rest" in
                "[A") CURRENT=$(( (CURRENT - 1 + TOTAL) % TOTAL )) ;;
                "[B") CURRENT=$(( (CURRENT + 1) % TOTAL )) ;;
            esac
            continue
        fi

        case "$key" in
            "k"|"K") CURRENT=$(( (CURRENT - 1 + TOTAL) % TOTAL )) ;;
            "j"|"J") CURRENT=$(( (CURRENT + 1) % TOTAL )) ;;
            "1"|"2"|"3"|"4"|"5"|"6"|"7")
                CURRENT=$((key - 1))
                ;;
            "s"|"S")
                link_storage
                hide_cursor
                ;;
            ""|$'\n'|$'\r')
                ACTIVE_INDEX=$CURRENT
                break
                ;;
            "q"|"Q")
                wipe_screen
                echo -e "\n  ${C_YELLOW}Batal, tidak ada perubahan.${C_RESET}\n"
                exit 0
                ;;
        esac
    done
    show_cursor
fi

# Apply the chosen agent template
chosen_key="${KEYS[$ACTIVE_INDEX]}"
src_template="$AGENTS_DIR/$chosen_key.md"

if [ -f "$src_template" ]; then
    cp "$src_template" "$ACTIVE_AGENT_FILE"
fi

# Also update MT storage symlink if storage accessible
if [ -d "/sdcard" ]; then
    ln -sf "$ACTIVE_AGENT_FILE" "$MT_STORAGE_FILE" 2>/dev/null || true
fi

wipe_screen
echo ""
echo -e "  ${C_GREEN}✓ Agent aktif:${C_RESET} ${C_WHITE}${C_BOLD}$chosen_key.md${C_RESET}"
echo -e "  ${C_DIM}Tersimpan di:${C_RESET} ${C_CYAN}$ACTIVE_AGENT_FILE${C_RESET}"
if [ -f "$MT_STORAGE_FILE" ]; then
    echo -e "  ${C_DIM}Shortcut MT Manager:${C_RESET} ${C_CYAN}$MT_STORAGE_FILE${C_RESET}"
fi
echo ""
echo -e "  ${C_DIM}Jalankan ${C_CYAN}opencode${C_DIM} untuk mulai ngoding bareng agent ini!${C_RESET}\n"
